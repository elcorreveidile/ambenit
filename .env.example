# ─────────────────────────────────────────────────────────────────────────
#  ambenit — variables de entorno. Copia a .env.local y rellena.
# ─────────────────────────────────────────────────────────────────────────

# Base de datos (Neon / Postgres). La cadena "pooled" de tu proyecto Neon.
DATABASE_URL="postgres://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob (almacenamiento de las fotos subidas desde /admin).
# En Vercel se inyecta sola al crear el store; en local, pega el token aquí.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"

# Auth.js: secreto de firma. Genera uno con:  npx auth secret
AUTH_SECRET="pon_aqui_un_secreto_largo"

# Email para el "magic link" — se envía por la API de Brevo (no SMTP).
# API key de Brevo (SMTP & API → API Keys), empieza por xkeysib-...
BREVO_API_KEY="xkeysib-xxxxxxxx"
# Remitente: debe estar VERIFICADO en Brevo (dominio o email).
EMAIL_FROM="ambenit <no-reply@ambenit.com>"

# Allowlist: SOLO este email puede entrar al panel /admin (el de Antonio).
ADMIN_EMAIL="antonio@sudominio.com"
